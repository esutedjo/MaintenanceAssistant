# Copy to .env.local and fill in. Never commit .env.local.

# live = query Zetaris on AWS; snapshot = Parquet samples in the repo (cloud agents, tests, judging)
ZETARIS_MODE=snapshot

# PostgreSQL (RDS hackathon-pg)
PG_HOST=
PG_PORT=5432
PG_SSLMODE=require
PG_DB_TELEMETRY=telemetry
PG_DB_CMMS=cmms
PG_DB_KNOWLEDGE=knowledge
# Seed/ingest only
PG_LOADER_USER=
PG_LOADER_PASSWORD=
# Application write path, cmms only
PG_APP_USER=
PG_APP_PASSWORD=

# Zetaris AI Data Gateway
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_REST_URL=

# Shared context: meterless = context-service (World Model + H-MEM), sqlite = local fallback.
# With meterless, the app falls back to SQLite automatically when the service is unreachable.
CONTEXT_STORE=meterless
CONTEXT_SERVICE_URL=http://127.0.0.1:8710
CONTEXT_SQLITE_PATH=.state/context.sqlite
# Read by context-service (Node) from its own environment; defaults shown, paths relative to context-service/
# CONTEXT_SERVICE_PORT=8710
# CONTEXT_STATE_DIR=.state
# CONTEXT_LOG_DIR=../logs

# Meterless Nightshift: primary AI provider. URL and runtime token come from Nightshift's Console.
# The NVIDIA key belongs in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=turbofan-maintenance-agent
LLM_TIMEOUT_S=180

# Interim fallback, used only when Nightshift is unreachable. Leave empty once Nightshift runs.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
