# Copy to .env.local and fill in. Never commit .env.local.

# live = query Zetaris on AWS; snapshot = Parquet samples in the repo (cloud agents, tests, judging)
ZETARIS_MODE=snapshot

# PostgreSQL (RDS hackathon-pg)
PG_HOST=
PG_PORT=5432
PG_SSLMODE=require
PG_DB_TELEMETRY=telemetry
PG_DB_CMMS=cmms
PG_DB_KNOWLEDGE=knowledge
# Seed/ingest only
PG_LOADER_USER=
PG_LOADER_PASSWORD=
# Application write path, cmms only
PG_APP_USER=
PG_APP_PASSWORD=

# Zetaris AI Data Gateway
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_REST_URL=

# NVIDIA hosted models (model IDs from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
