# Placeholder names only. Copy to .env.local and fill in there.
# .env.local is gitignored. Do not put real keys in this file.
# Sample mode needs no environment file: SAMPLE_MODE=true runs on the committed snapshots.

SAMPLE_MODE=true
ZETARIS_MODE=snapshot

# POST /run: runs at once (503 when busy); "record": true stores inspection findings only when this is true.
RUN_CONCURRENCY=4
API_ALLOW_RECORD=false

# Live Zetaris (leave empty for sample mode)
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMEOUT_S=10
ZETARIS_BUDGET_S=30

# Postgres, only for seeding and the live work-order write. Not used in sample mode.
PG_HOST=localhost
PG_PORT=5432
PG_SSLMODE=require
PG_DB_TELEMETRY=telemetry
PG_DB_CMMS=cmms
PG_DB_KNOWLEDGE=knowledge
PG_LOADER_USER=
PG_LOADER_PASSWORD=
PG_APP_USER=
PG_APP_PASSWORD=

# Meterless. Nightshift is the only model provider: the runtime token comes from Nightshift, and the NVIDIA key stays
# in Nightshift's Providers tab, not here.
# Context store: unset means the Meterless context service in live mode and SQLite in sample mode. Set
# CONTEXT_STORE=meterless to use the local context service in sample mode too (SQLite, flagged, if it does not answer).
# CONTEXT_STORE=meterless
CONTEXT_SERVICE_URL=http://127.0.0.1:8710
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=turbofan-maintenance-agent
METERLESS_CRITIC_MODEL=meterless/auto
METERLESS_CRITIC_APP=turbofan-maintenance-critic
CRITIC_TIMEOUT_S=45
LLM_TIMEOUT_S=180
RUN_TIMEOUT_S=120
